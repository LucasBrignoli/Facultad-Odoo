<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--punto 40 / unidad 2 - puntos 8 y 9-->
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!--unidad 2 - punto 12: lista con todas las ofertas para el menú Ofertas.
        Tiene mayor priority para que la página Ofertas de la propiedad siga usando la lista anterior.-->
    <record id="estate_property_offer_view_list_all" model="ir.ui.view">
        <field name="name">estate.property.offer.list.all</field>
        <field name="model">estate.property.offer</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="property_type_id"/>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!--unidad 2 - punto 12-->
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="property_type_id"/>
                            <field name="partner_id"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="validity"/>
                            <field name="date_deadline"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--unidad 2 - punto 12: agrupar ofertas por tipo de propiedad-->
    <record id="estate_property_offer_view_search" model="ir.ui.view">
        <field name="name">estate.property.offer.search</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="property_type_id"/>

                <separator/>
                <filter string="Tipo de propiedad" name="group_property_type"
                        context="{'group_by': 'property_type_id'}"/>
                <filter string="Estado" name="group_status"
                        context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <!--unidad 2 - punto 12-->
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Ofertas</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="estate_property_offer_view_list_all"/>
    </record>
</odoo>
